#!/bin/bash
#
# tsm - A minimal, keyboard-driven tmux session manager
#
# Usage: tsm [options]
#
# Options:
#   -h, --help     Show this help message
#   --config       Print config file location
#   -v, --version  Show version information
#

set -euo pipefail

# ============================================================================
# SECTION 1: XDG PATHS & DIRECTORIES
# ============================================================================

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tsm"
CONFIG_FILE="$CONFIG_DIR/config"

# ============================================================================
# SECTION 2: DEFAULT CONFIGURATION
# ============================================================================

# Defaults; the environment and the config file can override them.
: "${TERMINAL:=foot}"
: "${MENU_LAUNCHER:=wofi}"
: "${RECENT_SESSIONS_COUNT:=10}"

# ============================================================================
# SECTION 3: INITIALIZATION & CONFIG LOADING
# ============================================================================

init_config() {
    mkdir -p "$CONFIG_DIR"

    if [[ ! -f "$CONFIG_FILE" ]]; then
        cat > "$CONFIG_FILE" << 'EOF'
# tsm configuration
# Uncomment a line to override the default.

# Terminal emulator command. tsm appends "tmux attach-session -t <name>".
# Add the flag your terminal needs before a command, e.g. "alacritty -e".
#TERMINAL="foot"

# Menu launcher: wofi, rofi, dmenu, or fzf
#MENU_LAUNCHER="wofi"

# Number of sessions to show in the menu
#RECENT_SESSIONS_COUNT="10"
EOF
    fi
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi
}

# ============================================================================
# SECTION 4: CORE FUNCTIONS
# ============================================================================

# Session names, most recently active first.
get_sessions() {
    tmux list-sessions -F '#{session_activity} #{session_name}' 2>/dev/null \
        | sort -rn \
        | cut -d' ' -f2- \
        | head -n "$RECENT_SESSIONS_COUNT" \
        || true
}

# The "=" prefix makes tmux match the session name exactly. Without it,
# "-t dev" also matches a session called "development".
session_exists() {
    local name="$1"
    tmux has-session -t "=$name" 2>/dev/null
}

create_session() {
    local name="$1"
    tmux new-session -d -s "$name"
}

attach_session() {
    local name="$1"
    # TERMINAL is intentionally unquoted so it can carry flags ("alacritty -e").
    # shellcheck disable=SC2086
    $TERMINAL tmux attach-session -t "=$name" &
}

normalize_session_name() {
    local input="$1"
    # tmux replaces dots and colons in session names, so avoid them up front
    echo "$input" | tr ' .:' '---' | sed 's/--*/-/g; s/^-//; s/-$//'
}

notify() {
    local message="$1"
    if command -v notify-send &>/dev/null; then
        notify-send "tsm" "$message"
    else
        echo "[tsm] $message" >&2
    fi
}

# ============================================================================
# SECTION 5: MENU & UI
# ============================================================================

ICON_NEW="✨"
ICON_SESSION="💻"
MENU_NEW="$ICON_NEW New Session"

build_menu() {
    echo "$MENU_NEW"

    local sessions
    sessions=$(get_sessions)
    if [[ -n "$sessions" ]]; then
        while IFS= read -r session; do
            echo "$ICON_SESSION $session"
        done <<< "$sessions"
    fi
}

check_launcher() {
    case "$MENU_LAUNCHER" in
        wofi|rofi|dmenu|fzf) ;;
        *)
            echo "Unknown menu launcher: $MENU_LAUNCHER" >&2
            echo "Supported: wofi, rofi, dmenu, fzf" >&2
            exit 1
            ;;
    esac
}

show_menu() {
    case "$MENU_LAUNCHER" in
        wofi)
            wofi --dmenu --prompt "tmux" --cache-file=/dev/null
            ;;
        rofi)
            rofi -dmenu -p "tmux"
            ;;
        dmenu)
            dmenu -p "tmux"
            ;;
        fzf)
            fzf --prompt="tmux> " --height=40%
            ;;
    esac
}

prompt_input() {
    local prompt_text="$1"
    local input

    case "$MENU_LAUNCHER" in
        wofi)
            echo "" | wofi --dmenu \
                --prompt "$prompt_text" \
                --cache-file=/dev/null \
                --lines 0
            ;;
        rofi)
            echo "" | rofi -dmenu -p "$prompt_text" -l 0
            ;;
        dmenu)
            echo "" | dmenu -p "$prompt_text"
            ;;
        *)
            read -r -p "$prompt_text: " input
            echo "$input"
            ;;
    esac
}

create_new_session() {
    local session_name
    session_name=$(prompt_input "Session name")

    [[ -z "$session_name" ]] && return 0

    local normalized
    normalized=$(normalize_session_name "$session_name")

    if [[ -z "$normalized" ]]; then
        notify "Invalid session name"
        return 1
    fi

    if session_exists "$normalized"; then
        notify "Session already exists: $normalized"
        attach_session "$normalized"
        return 0
    fi

    create_session "$normalized"
    attach_session "$normalized"
}

handle_selection() {
    local selection="$1"

    if [[ "$selection" == "$MENU_NEW" ]]; then
        create_new_session
        return
    fi

    # Strip the icon prefix; keep the rest verbatim, since sessions created
    # outside tsm may contain spaces.
    local session_name="${selection#"$ICON_SESSION "}"

    if session_exists "$session_name"; then
        attach_session "$session_name"
    else
        notify "Session not found: $session_name"
        exit 1
    fi
}

# ============================================================================
# SECTION 6: COMMAND LINE INTERFACE
# ============================================================================

show_help() {
    cat << 'EOF'
tsm - A minimal, keyboard-driven tmux session manager

USAGE:
    tsm [OPTIONS]

OPTIONS:
    -h, --help     Show this help message
    --config       Print config file location
    -v, --version  Show version information

CONFIGURATION:
    Config file: ~/.config/tsm/config

KEYBINDING EXAMPLES:
    Hyprland:  bind = SUPER, T, exec, tsm
    Sway:      bindsym $mod+t exec tsm
    i3:        bindsym $mod+t exec --no-startup-id tsm
EOF
}

# ============================================================================
# SECTION 7: MAIN ENTRY POINT
# ============================================================================

main() {
    case "${1:-}" in
        --help|-h)
            show_help
            exit 0
            ;;
        --config)
            echo "$CONFIG_FILE"
            exit 0
            ;;
        --version|-v)
            echo "tsm 0.1.0"
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Use --help for usage information" >&2
            exit 1
            ;;
    esac

    init_config
    load_config
    check_launcher

    # A cancelled menu exits non-zero; treat it as an empty selection.
    local selection
    selection=$(build_menu | show_menu) || true

    [[ -z "$selection" ]] && exit 0

    handle_selection "$selection"
}

main "$@"
